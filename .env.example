# Local environment template for Oasis Agent (commit this file, never commit .env).
#
# Copy to .env and fill in real values. `.env` is git-ignored; the server
# launcher (`make run-server`) sources it automatically and exports the values,
# so tokens never appear in the shell history or in any committed file.
#
# Optional operation token. When unset, operation endpoints (trigger shadow
# run, gate approvals) fail closed with 503; set one to enable them.
OASIS_SERVER_OPS_TOKEN=change-me-to-a-long-random-token
